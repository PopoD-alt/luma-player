From: sdas <local-build-support>
Subject: [PATCH] Keep LGPL-profile AArch64 AC3DSP and CRC on portable C

FFmpeg8.1.2 selects three explicitly GPL-granted AArch64 implementation
units even when CONFIG_GPL=0. Gate those objects and corresponding optimized
dispatch on the GPL build flag; existing LGPL C fallbacks remain selected.
Other AArch64 SIMD is unchanged. This patch adds no replacement codec code.

SPDX-License-Identifier: MIT (original build-support changes only; upstream
source/patch context retains its own licenses).

--- a/libavcodec/aarch64/Makefile
+++ b/libavcodec/aarch64/Makefile
@@ -1,5 +1,7 @@
 # subsystems
+ifeq ($(CONFIG_GPL),yes)
 OBJS-$(CONFIG_AC3DSP)                   += aarch64/ac3dsp_init_aarch64.o
+endif
 OBJS-$(CONFIG_FDCTDSP)                  += aarch64/fdctdsp_init_aarch64.o
 OBJS-$(CONFIG_FMTCONVERT)               += aarch64/fmtconvert_init.o
 OBJS-$(CONFIG_H264CHROMA)               += aarch64/h264chroma_init_aarch64.o
@@ -42,7 +44,9 @@
 # subsystems
 NEON-OBJS-$(CONFIG_AAC_DECODER)         += aarch64/sbrdsp_neon.o
 NEON-OBJS-$(CONFIG_AAC_ENCODER)         += aarch64/aacencdsp_neon.o
+ifeq ($(CONFIG_GPL),yes)
 NEON-OBJS-$(CONFIG_AC3DSP)              += aarch64/ac3dsp_neon.o
+endif
 NEON-OBJS-$(CONFIG_FDCTDSP)             += aarch64/fdctdsp_neon.o
 NEON-OBJS-$(CONFIG_FMTCONVERT)          += aarch64/fmtconvert_neon.o
 NEON-OBJS-$(CONFIG_H264CHROMA)          += aarch64/h264cmc_neon.o
--- a/libavcodec/ac3dsp.c
+++ b/libavcodec/ac3dsp.c
@@ -389,7 +389,7 @@
     c->downmix               = NULL;
     c->downmix_fixed         = NULL;
 
-#if ARCH_AARCH64
+#if ARCH_AARCH64 && CONFIG_GPL
     ff_ac3dsp_init_aarch64(c);
 #elif ARCH_ARM
     ff_ac3dsp_init_arm(c);
--- a/libavutil/aarch64/Makefile
+++ b/libavutil/aarch64/Makefile
@@ -2,7 +2,9 @@
         aarch64/float_dsp_init.o                                      \
         aarch64/tx_float_init.o                                       \
 
+ifeq ($(CONFIG_GPL),yes)
 ARMV8-OBJS += aarch64/crc.o
+endif
 
 NEON-OBJS += aarch64/float_dsp_neon.o                                 \
              aarch64/tx_float_neon.o                                  \
--- a/libavutil/crc.c
+++ b/libavutil/crc.c
@@ -25,7 +25,7 @@
 #include "bswap.h"
 #include "crc.h"
 #include "error.h"
-#if ARCH_AARCH64
+#if ARCH_AARCH64 && CONFIG_GPL
 #include "libavutil/aarch64/crc.h"
 #elif ARCH_X86
 #include "libavutil/x86/crc.h"
@@ -388,7 +388,7 @@
         return NULL;
 // Check for arch-specific extensions first to avoid initializing
 // ordinary CRC tables unnecessarily.
-#if ARCH_AARCH64
+#if ARCH_AARCH64 && CONFIG_GPL
     const AVCRC *table = ff_crc_get_table_aarch64(crc_id);
     if (table)
         return table;
@@ -418,7 +418,7 @@
                 const uint8_t *buffer, size_t length)
 {
     if (ctx[0]) {
-#if ARCH_AARCH64
+#if ARCH_AARCH64 && CONFIG_GPL
         return ff_crc_aarch64(ctx, crc, buffer, length);
 #elif ARCH_X86
         return ff_crc_x86(ctx, crc, buffer, length);
